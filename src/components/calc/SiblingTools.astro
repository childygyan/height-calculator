---
/**
 * "More calculators" sibling-link grid for EN-only calculator pages.
 * Renders every tool except the current page.
 */
import { CALC_TOOLS } from "./toolList.js";

interface Props {
  current: string;
  title?: string;
}

const { current, title = "More height calculators" } = Astro.props;
const siblings = CALC_TOOLS.filter((t) => t.href !== current);
---

<section class="mt-14 sm:mt-20">
  <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight text-center">
    {title}
  </h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-8">
    {siblings.map((tool) => (
      <a
        href={tool.href}
        class="group rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-5 shadow-soft-sm hover:shadow-soft hover:border-brand-400 dark:hover:border-brand-600 transition-all"
      >
        <div class="flex items-start justify-between gap-3">
          <h3 class="font-bold text-slate-900 dark:text-white text-sm sm:text-base group-hover:text-brand-600 dark:group-hover:text-emerald-400 transition-colors">
            {tool.name}
          </h3>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 text-slate-300 group-hover:text-brand-500 group-hover:translate-x-0.5 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </div>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1.5 leading-relaxed">{tool.desc}</p>
      </a>
    ))}
  </div>
</section>
