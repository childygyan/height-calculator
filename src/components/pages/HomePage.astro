---
// Locale-aware homepage dispatcher.
// English renders the full calculator-first homepage (with the interactive
// tool); every other locale renders the localized calculator-first homepage,
// whose CTAs link to the EN-only /height-calculator/ hub.
import HomePageEn from './HomePageEn.astro';
import HomePageLocalized from './HomePageLocalized.astro';
import type { Locale } from '../../i18n/locales';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

{locale === 'en' ? <HomePageEn /> : <HomePageLocalized locale={locale} />}
