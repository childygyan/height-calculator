---
// EN-ONLY calculator-first homepage (Phase 2 repositioning).
// Other locales keep rendering the legacy sections in HomePage.astro
// until their own rewrite phase; all copy here is intentionally English.
import Layout from '../../layouts/Layout.astro';
import ComparisonTool from '../ComparisonTool.astro';
import HeroSection from '../HeroSection.astro';
import FAQ from '../FAQ.astro';
import { SITE } from '../../config/site';
import { t } from '../../i18n';

const canonicalUrl = `${SITE.siteUrl}/`;

const steps = [
  {
    number: '1',
    title: 'Measure',
    text: 'Measure height accurately — barefoot, back straight against a wall, heels together — to the nearest 0.1 cm or ⅛ inch. For babies, measure lying down (length).',
  },
  {
    number: '2',
    title: 'Enter',
    text: 'Enter the height in centimeters or feet and inches. Add age and sex for percentile checks, or both parents’ heights for the child adult-height predictor.',
  },
  {
    number: '3',
    title: 'Understand',
    text: 'Get instant unit conversions, percentile rankings against CDC & WHO growth charts, and honest child height estimates — with the data behind every number.',
  },
];
---

<Layout
  title={t('en', 'meta.defaultTitle')}
  description={t('en', 'meta.defaultDesc')}
  canonicalUrl={canonicalUrl}
  locale="en"
>
  <div class="max-w-[1680px] mx-auto px-3 sm:px-6 lg:px-8 py-2 sm:py-4">
    <!-- Hero Section -->
    <HeroSection locale="en" />

    <!-- Interactive Calculator Workspace -->
    <section id="calculator-tool" class="scroll-mt-20 my-8 sm:my-12">
      <div class="mb-4 text-center">
        <span class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-blue-400 bg-brand-50 dark:bg-slate-800 px-3 py-1 rounded-full">
          {t('en', 'section.liveToolBadge')}
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
          {t('en', 'section.liveToolTitle')}
        </h2>
      </div>
      <ComparisonTool locale="en" />
    </section>

    <!-- How It Works: 3 steps -->
    <section id="how-it-works" class="mt-20 pt-12 border-t border-slate-200 dark:border-slate-800 scroll-mt-20">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-10">
          <span class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-blue-400 bg-brand-50 dark:bg-slate-800 px-3 py-1 rounded-full">
            How It Works
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-3">
            Three Steps to Understand Any Height
          </h2>
          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mt-2 max-w-2xl mx-auto">
            No sign-up, no downloads. Measure once, enter the numbers, and get answers grounded in real growth data.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {steps.map((step) => (
            <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-soft text-center">
              <div class="w-12 h-12 mx-auto rounded-full bg-brand-600 dark:bg-blue-500 text-white font-black text-xl flex items-center justify-center mb-4">
                {step.number}
              </div>
              <h3 class="font-extrabold text-lg text-slate-900 dark:text-white">
                {step.title}
              </h3>
              <p class="text-sm text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
                {step.text}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Trust / disclaimer strip -->
    <section class="mt-20">
      <div class="max-w-5xl mx-auto">
        <div class="p-6 sm:p-8 rounded-3xl bg-brand-50/60 dark:bg-slate-800/60 border border-brand-200/60 dark:border-slate-700 shadow-soft-sm">
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <div class="w-11 h-11 shrink-0 rounded-2xl bg-brand-600 dark:bg-blue-500 text-white flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <polyline points="9 12 11 14 15 10"></polyline>
              </svg>
            </div>
            <div>
              <h2 class="font-extrabold text-base sm:text-lg text-slate-900 dark:text-white">
                Built on real CDC &amp; WHO growth data
              </h2>
              <p class="text-sm text-slate-600 dark:text-slate-300 mt-1 leading-relaxed">
                Percentiles and growth references come from the CDC growth charts and WHO Child Growth Standards — not guesswork.
                Results are educational estimates, never medical advice. If you have concerns about a child’s growth, please consult a pediatrician.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ teaser (first 4 questions) -->
    <FAQ locale="en" limit={4} />

    <!-- Final CTA -->
    <section class="mt-20 mb-8">
      <div class="max-w-5xl mx-auto">
        <div class="p-8 sm:p-12 rounded-3xl bg-gradient-to-br from-brand-600 to-blue-700 dark:from-brand-700 dark:to-blue-800 text-center shadow-soft">
          <span class="text-xs font-bold uppercase tracking-widest text-blue-100 bg-white/15 px-3 py-1 rounded-full">
            Free • No sign-up
          </span>
          <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight mt-4">
            Ready to calculate your height?
          </h2>
          <p class="text-sm sm:text-base text-blue-100 mt-3 max-w-2xl mx-auto leading-relaxed">
            Open the Height Calculator hub — percentiles, growth charts, child height prediction and unit conversion, all in one place.
          </p>
          <a
            href="/height-calculator/"
            class="inline-flex items-center justify-center mt-6 px-8 py-3.5 rounded-xl font-bold text-sm sm:text-base text-brand-700 bg-white hover:bg-blue-50 active:bg-blue-100 shadow-soft transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
          >
            Start Calculating
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
