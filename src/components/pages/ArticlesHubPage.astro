---
import Layout from '../../layouts/Layout.astro';
import type { ArticleUiStrings, ArticleData } from '../../data/articles/types';
import { getHubAlternates, getArticlePath } from '../../data/articles';
import { SITE } from '../../config/site';
import { type Locale } from '../../i18n/locales';
import { isRTL } from '../../i18n';

interface Props {
  ui: ArticleUiStrings;
  articles: ArticleData[];
  locale: Locale;
}

const { ui, articles, locale } = Astro.props;
const hubPath = locale === 'en' ? `/${ui.hubSegment}/` : `/${locale}/${ui.hubSegment}/`;
const canonicalUrl = `${SITE.siteUrl}${hubPath}`;
const isArabic = isRTL(locale);
const hreflangLinks = getHubAlternates();

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ui.homeLabel, item: `${SITE.siteUrl}${locale === 'en' ? '/' : `/${locale}/`}` },
    { '@type': 'ListItem', position: 2, name: ui.navLabel, item: canonicalUrl },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: ui.hubTitle,
  description: ui.hubDescription,
  url: canonicalUrl,
};
---

<Layout
  title={ui.hubTitle}
  description={ui.hubDescription}
  canonicalUrl={canonicalUrl}
  locale={locale}
  suppressDefaultSchema={true}
>
  <Fragment slot="head">
    {hreflangLinks.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  </Fragment>

  <div class={`max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 ${isArabic ? 'text-right' : 'text-left'}`} dir={isArabic ? 'rtl' : 'ltr'}>
    <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href={locale === 'en' ? '/' : `/${locale}/`} class="hover:text-brand-600 dark:hover:text-emerald-400 transition-colors">{ui.homeLabel}</a>
      <span class="text-slate-300 dark:text-slate-700">/</span>
      <span class="text-slate-900 dark:text-white" aria-current="page">{ui.navLabel}</span>
    </nav>

    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight mb-4">
        {ui.hubTitle}
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        {ui.hubSubtitle}
      </p>
    </header>

    <div class="grid grid-cols-1 gap-5">
      {articles.map((article) => (
        <a
          href={getArticlePath(locale, article)}
          class="block p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-xs hover:shadow-md hover:border-brand-300 dark:hover:border-emerald-700 transition-all"
        >
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-[11px] font-bold bg-brand-50 dark:bg-emerald-950/50 text-brand-600 dark:text-emerald-400 mb-3">
            <span>{article.badge}</span>
            <span class="text-slate-300 dark:text-slate-700">•</span>
            <span>{article.readTime}</span>
          </div>
          <h2 class="text-xl font-extrabold text-slate-900 dark:text-white mb-2">{article.title}</h2>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{article.subtitle}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>
