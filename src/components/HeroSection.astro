---
/**
 * Calculator-first hero: badge, H1, description, CTAs, and a
 * growth-chart motif visual (ruler + percentile curve, pure SVG).
 * One visual for every locale — no comparison figures anywhere.
 */
import { getLocaleFromUrl, isRTL, t } from '../i18n';
import type { Locale } from '../i18n/locales';

interface Props {
  locale?: Locale;
}

const { locale = getLocaleFromUrl(Astro.url) } = Astro.props;
const rtl = isRTL(locale);

// Calculator hub is EN-only; the How-It-Works anchor lives on this page.
const primaryCtaHref = '/height-calculator/';
const secondaryCtaHref = '#how-it-works';
---

<section class="max-w-5xl mx-auto text-center pt-6 sm:pt-10 pb-8 sm:pb-12">
  <!-- Badge -->
  <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-brand-50 dark:bg-brand-950/60 text-brand-700 dark:text-brand-300 border border-brand-200/80 dark:border-brand-800/60 mb-5 shadow-soft-sm">
    <span class="w-2 h-2 rounded-full bg-brand-600 dark:bg-brand-400 animate-pulse"></span>
    <span>{t(locale, 'hero.badge')}</span>
  </div>

  <!-- H1 -->
  <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
    {t(locale, 'hero.title')}
  </h1>

  <!-- Supporting text -->
  <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 mt-4 leading-relaxed max-w-3xl mx-auto">
    {t(locale, 'hero.description')}
  </p>

  <!-- CTAs -->
  <div class="mt-7 flex flex-wrap items-center justify-center gap-3.5">
    <a
      href={primaryCtaHref}
      class="inline-flex items-center justify-center px-7 py-3.5 rounded-2xl font-bold text-sm sm:text-base text-white bg-brand-600 hover:bg-brand-700 active:bg-brand-800 shadow-soft transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
    >
      {t(locale, 'hero.startComparing')}
      <svg xmlns="http://www.w3.org/2000/svg" class={`w-4 h-4 ${rtl ? 'mr-2 rotate-180' : 'ml-2'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
    <a
      href={secondaryCtaHref}
      class="inline-flex items-center justify-center px-6 py-3.5 rounded-2xl font-semibold text-sm sm:text-base text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 shadow-soft-sm transition-all"
    >
      {t(locale, 'hero.exploreComparisons')}
    </a>
  </div>

  <!-- Growth-chart visual -->
  <div class="mt-10 max-w-3xl mx-auto p-4 sm:p-6 rounded-3xl bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 shadow-soft">
    <div class="flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-300 font-semibold mb-4 border-b border-slate-100 dark:border-slate-700/60 pb-3">
      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
      <span>{t(locale, 'hero.visualTitle')}</span>
    </div>

    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-b from-brand-50/80 to-white dark:from-slate-900/60 dark:to-slate-900/20 border border-slate-100 dark:border-slate-800 px-2 sm:px-6 pt-4 pb-2">
      <div class="relative h-60 sm:h-72">
        <!-- Ruler (left) -->
        <div class="absolute top-2 bottom-8 flex flex-col justify-between items-end text-[10px] font-bold text-slate-400 dark:text-slate-500" style="left: 0;" aria-hidden="true">
          {['200', '150', '100', '50', '0'].map((cm) => (
            <div class="flex items-center gap-1.5">
              <span>{cm} cm</span>
              <span class="block w-2.5 h-0.5 bg-slate-300 dark:bg-slate-600 rounded-full"></span>
            </div>
          ))}
        </div>

        <!-- Chart -->
        <svg viewBox="0 0 400 240" class="absolute inset-0 w-full h-full pl-14" role="img" aria-label={t(locale, 'hero.visualTitle')}>
          <defs>
            <linearGradient id="heroCurve" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="#10b981"></stop>
              <stop offset="100%" stop-color="#0d9488"></stop>
            </linearGradient>
            <linearGradient id="heroArea" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#10b981" stop-opacity="0.28"></stop>
              <stop offset="100%" stop-color="#10b981" stop-opacity="0"></stop>
            </linearGradient>
          </defs>

          <!-- Gridlines -->
          {[36, 84, 132, 180].map((y) => (
            <line x1="8" y1={y} x2="392" y2={y} stroke="currentColor" class="text-slate-200 dark:text-slate-700/60" stroke-width="1" stroke-dasharray="3 5"></line>
          ))}

          <!-- Percentile band (decorative) -->
          <path d="M16,178 C90,150 150,128 220,100 C280,78 330,66 388,56 L388,84 C330,94 280,106 220,134 C150,162 90,184 16,210 Z" fill="#a7f3d0" opacity="0.35" class="dark:opacity-20"></path>

          <!-- Growth curve -->
          <path d="M16,196 C90,168 150,146 220,118 C280,94 330,80 388,68" fill="none" stroke="url(#heroCurve)" stroke-width="4.5" stroke-linecap="round"></path>
          <path d="M16,196 C90,168 150,146 220,118 C280,94 330,80 388,68 L388,228 L16,228 Z" fill="url(#heroArea)"></path>

          <!-- Milestone dots -->
          <g>
            <circle cx="150" cy="146" r="7" fill="#059669" stroke="#fff" stroke-width="3"></circle>
            <circle cx="260" cy="102" r="7" fill="#0d9488" stroke="#fff" stroke-width="3"></circle>
            <circle cx="345" cy="76" r="8" fill="#f59e0b" stroke="#fff" stroke-width="3"></circle>
          </g>

          <!-- Axis captions -->
          <text x="200" y="236" text-anchor="middle" font-size="10" font-weight="700" fill="currentColor" class="text-slate-400">0 — 20 yrs</text>
        </svg>

        <!-- Floating chip: conversion -->
        <div class="absolute top-3 right-2 sm:right-4 flex items-center gap-2 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-soft px-3.5 py-2">
          <span class="text-sm font-black tabular-nums text-slate-900 dark:text-white">175 <span class="text-xs font-bold text-slate-400">cm</span></span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
          <span class="text-sm font-black tabular-nums text-brand-700 dark:text-brand-300">5 ft 8.9 in</span>
        </div>

        <!-- Floating chip: percentile -->
        <div class="absolute bottom-10 left-14 sm:left-20 flex items-center gap-2 rounded-2xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 shadow-soft px-3.5 py-2">
          <span class="w-2 h-2 rounded-full bg-amber-400"></span>
          <span class="text-sm font-black tabular-nums">P62</span>
          <span class="text-[11px] font-semibold opacity-70">CDC 2–20y</span>
        </div>
      </div>
    </div>
  </div>
</section>
