---
import BrandLogo from './brand/BrandLogo.astro';
import { SITE } from '../config/site';
import { getLocaleFromUrl, getLocalizedPath, t } from '../i18n';
import type { Locale } from '../i18n/locales';

interface Props {
  locale?: Locale;
}

const { locale = getLocaleFromUrl(Astro.url) } = Astro.props;
const currentYear = new Date().getFullYear();

const exploreLinks = [
  { label: 'Height Calculator', href: '/height-calculator/' },
  { label: 'Charts', href: '/height-calculator/boys-chart/' },
  { label: t(locale, 'footer.about'), href: getLocalizedPath('/about/', locale) },
  { label: t(locale, 'footer.howToUse'), href: getLocalizedPath('/how-to-use/', locale) },
  { label: t(locale, 'footer.contact'), href: '/contact/' },
];

const legalLinks = [
  { label: t(locale, 'footer.privacy'), href: '/privacy/' },
  { label: t(locale, 'footer.terms'), href: '/terms/' },
];
---

<footer class="mt-20 border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 py-14 text-slate-600 dark:text-slate-400">
  <div class="max-w-[1680px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
      <!-- Brand Column -->
      <div class="lg:col-span-2 space-y-3">
        <BrandLogo size="md" />
        <p class="text-xs text-slate-500 dark:text-slate-400 max-w-sm leading-relaxed">
          {t(locale, 'brand.tagline')}. {t(locale, 'brand.description')}
        </p>
        <p class="text-[11px] text-slate-400 dark:text-slate-500">
          {t(locale, 'footer.platformStatement')}
        </p>
      </div>

      <!-- Explore Column (mirrors header nav) -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-100 mb-3">{t(locale, 'footer.tools')}</h4>
        <ul class="space-y-2 text-xs">
          {exploreLinks.map((l) => (
            <li>
              <a href={l.href} class="hover:text-brand-600 dark:hover:text-blue-400 transition-colors">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal Column -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-100 mb-3">{t(locale, 'footer.legal')}</h4>
        <ul class="space-y-2 text-xs">
          {legalLinks.map((l) => (
            <li>
              <a href={l.href} class="hover:text-brand-600 dark:hover:text-blue-400 transition-colors">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 border-t border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-400 dark:text-slate-500">
      <div class="flex flex-wrap items-center gap-1.5">
        <span>© {currentYear} {SITE.name}. {t(locale, 'footer.allRightsReserved')}</span>
        <span>•</span>
        <span>Built by <a href="https://github.com/fkdigitalmedia" target="_blank" rel="noopener noreferrer" class="font-semibold text-slate-600 dark:text-slate-300 hover:text-brand-600 dark:hover:text-blue-400 transition-colors">FK Digital Media</a></span>
      </div>
      <div class="flex items-center gap-4 text-[11px]">
        <span>{t(locale, 'footer.fastPlatform')}</span>
        <span>•</span>
        <a href={getLocalizedPath('/', locale)} class="text-brand-600 dark:text-blue-400 hover:underline">{SITE.domain}</a>
      </div>
    </div>
  </div>
</footer>
