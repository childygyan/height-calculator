---
import BrandLogo from './brand/BrandLogo.astro';
import LanguageSwitcher from './i18n/LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { getLocaleFromUrl, getLocalizedPath, t } from '../i18n';
import type { Locale } from '../i18n/locales';

interface Props {
  locale?: Locale;
}

const { locale = getLocaleFromUrl(Astro.url) } = Astro.props;

// Phase 1 repositioning: calculator-first nav. The /height-calculator/* pages are
// EN-only, so they use plain hrefs (no locale prefix). Localized pages keep getLocalizedPath.
const mainNav = [
  { label: t(locale, 'nav.calculator'), href: '/height-calculator/' },
  { label: t(locale, 'nav.charts'), href: '/height-calculator/boys-chart/' },
  { label: t(locale, 'nav.compare'), href: '/compare/' },
  { label: t(locale, 'nav.about'), href: getLocalizedPath('/about/', locale) },
  { label: t(locale, 'nav.howToUse'), href: getLocalizedPath('/how-to-use/', locale) },
  { label: t(locale, 'nav.contact'), href: '/contact/' },
];
---

<header class="sticky top-0 z-40 w-full bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 transition-colors shadow-xs">
  <div class="max-w-[1680px] mx-auto px-4 sm:px-6 lg:px-8 h-15 flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <BrandLogo size="md" showTagline={false} />

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-5 text-[13px] font-semibold text-slate-600 dark:text-slate-300">
      {mainNav.map((item) => (
        <a
          href={item.href}
          class="hover:text-brand-600 dark:hover:text-emerald-400 transition-colors py-1 hover:border-b-2 hover:border-brand-600"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Desktop CTA, Language Switcher & Theme Toggle -->
    <div class="hidden sm:flex items-center gap-2.5 flex-shrink-0">
      <!-- Language Switcher -->
      <LanguageSwitcher currentLocale={locale} />

      <!-- Dark / Night Theme Toggle Button -->
      <ThemeToggle />

      <a
        href="/height-calculator/boys-chart/"
        class="hidden xl:inline-flex items-center px-3 py-1.5 text-xs font-semibold text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 rounded-lg transition-colors"
      >
        {t(locale, 'nav.charts')}
      </a>
      <a
        href="/height-calculator/"
        class="inline-flex items-center justify-center px-4 py-2 text-xs sm:text-sm font-bold text-white bg-brand-600 hover:bg-brand-700 active:bg-brand-800 rounded-lg shadow-soft-sm transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
      >
        {t(locale, 'nav.calculator')}
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 ml-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <!-- Mobile Hamburger Menu Button, Language Switcher & Theme Toggle -->
    <div class="flex sm:hidden items-center gap-2">
      <LanguageSwitcher currentLocale={locale} />
      <ThemeToggle />
      <button
        id="mobile-menu-btn"
        type="button"
        class="inline-flex items-center justify-center p-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-4 pt-3 pb-6 space-y-1 shadow-soft-md max-h-[85vh] overflow-y-auto">
    {mainNav.map((item) => (
      <a
        href={item.href}
        class="block px-3 py-2 rounded-md text-sm font-semibold text-slate-700 dark:text-slate-200 hover:text-brand-600 dark:hover:text-emerald-400 hover:bg-slate-50 dark:hover:bg-slate-800 mobile-link"
      >
        {item.label}
      </a>
    ))}

    <div class="pt-3">
      <a href="/height-calculator/" class="w-full inline-flex items-center justify-center px-4 py-2.5 text-sm font-bold text-white bg-brand-600 hover:bg-brand-700 rounded-lg shadow-sm mobile-link">
        {t(locale, 'nav.calculator')}
      </a>
    </div>
  </div>
</header>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  if (mobileMenuBtn && mobileMenu && hamburgerIcon && closeIcon) {
    const toggleMenu = () => {
      const isExpanded = mobileMenuBtn.getAttribute('aria-expanded') === 'true';
      mobileMenuBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    };

    mobileMenuBtn.addEventListener('click', toggleMenu);

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (!mobileMenu.classList.contains('hidden')) {
          toggleMenu();
        }
      });
    });
  }
</script>
