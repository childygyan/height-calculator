---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config/site';
---

<Layout
  title={`Page Not Found | ${SITE.name}`}
  description="The page you requested could not be found. Try the Height Calculator or browse our help pages."
  noindex={true}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 text-center">
    <div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-brand-50 dark:bg-slate-800 text-brand-600 dark:text-emerald-400 font-black text-2xl mb-6 shadow-soft-sm">
      404
    </div>

    <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight mb-4">
      Page Not Found
    </h1>

    <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-lg mx-auto mb-8 leading-relaxed">
      We couldn't find the page you're looking for. It may have moved or been updated.
    </p>

    <!-- Quick Navigation Actions -->
    <div class="flex flex-wrap items-center justify-center gap-3 mb-12">
      <a
        href="/height-calculator/"
        class="px-6 py-3 rounded-xl font-bold text-sm text-white bg-brand-600 hover:bg-brand-700 shadow-soft-sm transition-all"
      >
        Height Calculator →
      </a>
      <a
        href="/height-calculator/boys-chart/"
        class="px-5 py-3 rounded-xl font-bold text-sm text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 transition-colors shadow-soft-sm"
      >
        Charts
      </a>
    </div>

    <!-- Helpful Links -->
    <div class="pt-10 border-t border-slate-200 dark:border-slate-800 text-left">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4 text-center">
        Helpful Links
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 max-w-xl mx-auto">
        <a
          href="/about/"
          class="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 hover:shadow-soft transition-all text-center"
        >
          <div class="font-bold text-sm text-slate-900 dark:text-white">
            About
          </div>
          <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Learn about Height Calculator
          </div>
        </a>

        <a
          href="/how-to-use/"
          class="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 hover:shadow-soft transition-all text-center"
        >
          <div class="font-bold text-sm text-slate-900 dark:text-white">
            How to Use
          </div>
          <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Guides and instructions
          </div>
        </a>

        <a
          href="/contact/"
          class="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-500 hover:shadow-soft transition-all text-center"
        >
          <div class="font-bold text-sm text-slate-900 dark:text-white">
            Contact
          </div>
          <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Get in touch with us
          </div>
        </a>
      </div>
    </div>
  </div>
</Layout>
