---
import Layout from '../../../layouts/Layout.astro';
import { getPtArticles } from '../../../data/articles';
import { SITE } from '../../../config/site';

const articles = getPtArticles();
const canonicalUrl = `${SITE.siteUrl}/pt/artigos/`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: `${SITE.siteUrl}/pt/` },
    { '@type': 'ListItem', position: 2, name: 'Artigos', item: canonicalUrl },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Artigos sobre Altura',
  description: 'Guias práticos sobre altura: média por país, como medir, previsão de altura infantil e percentis de crescimento.',
  url: canonicalUrl,
  inLanguage: 'pt-BR',
};
---

<Layout
  title="Artigos sobre Altura — Guias Práticos"
  description="Guias práticos em português sobre altura: altura média por país, como medir sua altura, previsão de altura infantil e percentis de crescimento."
  canonicalUrl={canonicalUrl}
  locale="pt"
  suppressDefaultSchema={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  </Fragment>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400 mb-6" aria-label="Breadcrumb">
      <a href="/pt/" class="hover:text-brand-600 dark:hover:text-emerald-400 transition-colors">Início</a>
      <span class="text-slate-300 dark:text-slate-700">/</span>
      <span class="text-slate-900 dark:text-white" aria-current="page">Artigos</span>
    </nav>

    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight mb-4">
        Artigos sobre Altura
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Guias práticos escritos para responder exatamente o que você pesquisou — sem enrolação.
      </p>
    </header>

    <div class="grid grid-cols-1 gap-5">
      {articles.map((article) => (
        <a
          href={`/pt/artigos/${article.slug}/`}
          class="block p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-xs hover:shadow-md hover:border-brand-300 dark:hover:border-emerald-700 transition-all"
        >
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-[11px] font-bold bg-brand-50 dark:bg-emerald-950/50 text-brand-600 dark:text-emerald-400 mb-3">
            <span>{article.badge}</span>
            <span class="text-slate-300 dark:text-slate-700">•</span>
            <span>{article.readTime}</span>
          </div>
          <h2 class="text-xl font-extrabold text-slate-900 dark:text-white mb-2">{article.title}</h2>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{article.subtitle}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>
