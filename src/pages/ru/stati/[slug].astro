---
import ArticlePage from '../../../components/pages/ArticlePage.astro';
import { getArticleSet, getArticleBySlug } from '../../../data/articles';
import type { Locale } from '../../../i18n/locales';

const locale = 'ru' as Locale;

export function getStaticPaths() {
  return getArticleSet('ru' as Locale).articles.map((article) => ({
    params: { slug: article.slug },
  }));
}

const { slug } = Astro.params;
const set = getArticleSet(locale);
const article = getArticleBySlug(locale, slug as string);

if (!article) {
  throw new Error(`Article not found: ${slug}`);
}
---

<ArticlePage article={article} ui={set.ui} locale={locale} />
