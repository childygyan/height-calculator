---
// EN-ONLY visual height comparison page: full ComparisonTool with all
// 11 entity categories (animals, anime, apparel, celebrities, female,
// fictional, films, male, objects, plants, sports).
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/seo/Breadcrumbs.astro";
import ComparisonTool from "../../components/ComparisonTool.astro";
import { CATEGORY_DEFINITIONS } from "../../lib/constants";
import { CATEGORY_COUNTS, SEARCHABLE_ASSETS } from "../../data/assetRegistry";
import { SITE } from "../../config/site";

const title = "Height Comparison Tool — Compare Any Heights Side by Side | Height Calculator";
const description =
  "Free visual height comparison tool: compare your height with 1,400+ figures — celebrities, athletes, animals, anime and film characters, everyday objects and more. See height differences side by side, in cm or ft/in.";
const canonicalUrl = `${SITE.siteUrl}/compare/`;

const faqs = [
  {
    q: "How does the height comparison tool work?",
    a: "Add people or pick figures from 11 categories — celebrities, athletes, animals, anime and film characters, everyday objects and more. Each figure is drawn to scale on the same canvas, so height differences are instantly visible. You can also add your own height and upload a custom image.",
  },
  {
    q: "How many figures can I compare?",
    a: `The library holds more than ${SEARCHABLE_ASSETS.toLocaleString("en-US")} searchable figures across 11 categories, and you can place several of them on the canvas at once. Use the search box to find a specific person, animal or object quickly.`,
  },
  {
    q: "Can I compare my own height?",
    a: "Yes. Enter your height in centimeters or feet and inches to add yourself to the canvas, or upload your own photo or silhouette for a personal side-by-side comparison.",
  },
  {
    q: "Are the figure heights accurate?",
    a: "Figure heights come from published measurements and reference data. They are close visual approximations meant for fun, intuitive comparison — not precise measurement. For exact personal measurements, use our height calculator tools instead.",
  },
  {
    q: "Is the comparison tool free?",
    a: "Yes — completely free, no sign-up. Everything runs in your browser; nothing you enter is uploaded or stored.",
  },
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} locale="en">
  <div class="max-w-[1680px] mx-auto px-3 sm:px-6 lg:px-8 py-2 sm:py-4">
    <Breadcrumbs
      locale="en"
      items={[
        { name: "Home", url: "/" },
        { name: "Height Comparison", url: "/compare/" },
      ]}
    />

    <!-- Hero -->
    <header class="text-center mt-6 sm:mt-10" id="compare">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-brand-50 text-brand-700 border border-brand-200/80 mb-4 dark:bg-brand-950/60 dark:text-brand-300 dark:border-brand-800/60">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-600 dark:text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 3v18"></path>
          <path d="M19 3v18"></path>
          <path d="M5 8h14"></path>
          <path d="M5 16h14"></path>
        </svg>
        <span>Free · No sign-up · {SEARCHABLE_ASSETS.toLocaleString("en-US")}+ figures</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        Height Comparison Tool
      </h1>
      <p class="text-lg sm:text-xl font-bold text-brand-700 dark:text-brand-300 mt-2">
        Compare, Convert &amp; Understand Any Height
      </p>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mt-4 leading-relaxed max-w-2xl mx-auto">
        See yourself next to anyone — or anything. Pick from {SEARCHABLE_ASSETS.toLocaleString("en-US")}+ figures
        across 11 categories, add your own height, and watch the differences appear
        side by side on one to-scale canvas.
      </p>
    </header>

    <!-- Category strip -->
    <section class="mt-8 sm:mt-10" aria-label="Figure categories">
      <div class="flex flex-wrap justify-center gap-2">
        {CATEGORY_DEFINITIONS.map((cat) => (
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 shadow-soft-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>
            {cat.label}
            <span class="text-slate-400 dark:text-slate-500 font-semibold">
              {(CATEGORY_COUNTS[cat.id as keyof typeof CATEGORY_COUNTS] ?? 0).toLocaleString("en-US")}
            </span>
          </span>
        ))}
      </div>
    </section>

    <!-- Interactive comparison workspace -->
    <section id="comparison-tool" class="scroll-mt-20 my-8 sm:my-12" aria-label="Height comparison workspace">
      <ComparisonTool locale="en" />
    </section>

    <!-- How it works: 3 steps -->
    <section class="mt-16 sm:mt-20" aria-label="How the comparison tool works">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-8">
          <span class="text-xs font-bold uppercase tracking-widest text-brand-700 dark:text-brand-300 bg-brand-100 dark:bg-brand-950/60 border border-brand-200/60 dark:border-brand-800/60 px-3.5 py-1.5 rounded-full">
            How It Works
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-3">
            Three Steps to Compare Any Heights
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {[
            { n: "1", t: "Pick figures", d: "Browse 11 categories or search the library — celebrities, athletes, animals, anime heroes, everyday objects and more." },
            { n: "2", t: "Add yourself", d: "Enter your height in cm or ft/in, or upload a custom image to stand on the canvas next to them." },
            { n: "3", t: "See the difference", d: "Every figure is drawn to scale on one canvas, so height gaps are obvious at a glance — share or screenshot the result." },
          ].map((step) => (
            <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-soft text-center">
              <div class="w-12 h-12 mx-auto rounded-full bg-brand-600 dark:bg-brand-500 text-white font-black text-xl flex items-center justify-center mb-4">
                {step.n}
              </div>
              <h3 class="font-extrabold text-lg text-slate-900 dark:text-white">{step.t}</h3>
              <p class="text-sm text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">{step.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mt-16 sm:mt-20" aria-label="Frequently asked questions">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-8">
          <span class="text-xs font-bold uppercase tracking-widest text-brand-700 dark:text-brand-300 bg-brand-100 dark:bg-brand-950/60 border border-brand-200/60 dark:border-brand-800/60 px-3.5 py-1.5 rounded-full">
            FAQ
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-3">
            Height Comparison Questions
          </h2>
        </div>
        <div class="space-y-3">
          {faqs.map((f) => (
            <details class="group rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-soft-sm overflow-hidden">
              <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer font-bold text-sm sm:text-base text-slate-900 dark:text-white list-none">
                {f.q}
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 text-brand-600 dark:text-brand-400 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </summary>
              <p class="px-5 pb-5 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    })} />

    <!-- Cross-link to calculator hub -->
    <section class="mt-16 sm:mt-20 mb-8">
      <div class="max-w-5xl mx-auto">
        <div class="p-8 sm:p-12 rounded-3xl bg-gradient-to-br from-brand-600 to-teal-700 dark:from-brand-700 dark:to-teal-800 text-center shadow-soft">
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-100 bg-white/15 px-3 py-1 rounded-full">
            More Tools
          </span>
          <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight mt-4">
            Want exact numbers too?
          </h2>
          <p class="text-sm sm:text-base text-emerald-100 mt-3 max-w-2xl mx-auto leading-relaxed">
            Open the Height Calculator hub — percentiles, growth charts, child height prediction and unit conversion, all in one place.
          </p>
          <a
            href="/height-calculator/"
            class="inline-flex items-center justify-center mt-6 px-8 py-3.5 rounded-xl font-bold text-sm sm:text-base text-brand-700 bg-white hover:bg-emerald-50 active:bg-emerald-100 shadow-soft transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
          >
            Open Height Calculator
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
