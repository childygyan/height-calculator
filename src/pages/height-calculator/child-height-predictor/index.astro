---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/seo/Breadcrumbs.astro";
import MedicalDisclaimer from "../../../components/MedicalDisclaimer.astro";
import PredictorTool from "../../../components/calc/PredictorTool.astro";
import CalcFaq from "../../../components/calc/CalcFaq.astro";
import SiblingTools from "../../../components/calc/SiblingTools.astro";
import TrustStrip from "../../../components/calc/TrustStrip.astro";
import { SITE } from "../../../config/site";

const title = "Child Height Predictor — Predict Adult Height from Parents' Heights | Height Calculator";
const description =
  "Free child height predictor: enter father's and mother's heights to estimate a child's adult height with an honest ±8.5 cm range (mid-parental height formula).";
const canonicalUrl = `${SITE.siteUrl}/height-calculator/child-height-predictor/`;

const faqs = [
  {
    q: "How does the child height predictor work?",
    a: "It uses the classic mid-parental height formula: for a boy, (father's height + mother's height + 13) ÷ 2; for a girl, (father's height + mother's height − 13) ÷ 2 — all in centimetres. The 13 cm adjustment reflects the average height difference between adult men and women.",
  },
  {
    q: "How accurate is the prediction?",
    a: "It estimates genetic target height, not a guaranteed outcome. Most children end up within ±8.5 cm of the predicted value — roughly ±2 standard deviations of prediction error. No method predicts a child's adult height exactly, which is why the range is always shown as part of the answer.",
  },
  {
    q: "What can make a child end up outside the predicted range?",
    a: "Nutrition, health conditions, the timing of puberty, and plain genetic variation all shift final height. The formula captures the biggest single factor — parents' heights — but it can't account for everything, so treat the range as likely, not certain.",
  },
  {
    q: "Does it work for adopted children or if I don't know a parent's height?",
    a: "The formula needs both parents' heights to work as designed. Without them, any 'prediction' would be a guess — so this tool asks for both and won't fabricate a result from half the inputs.",
  },
  {
    q: "Is my family's data stored?",
    a: "No. The calculation runs entirely in your browser; nothing you enter is sent to a server or stored.",
  },
];
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} locale="en">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
    <Breadcrumbs
      locale="en"
      items={[
        { name: "Home", url: "/" },
        { name: "Height Calculator", url: "/height-calculator/" },
        { name: "Child Height Predictor", url: "/height-calculator/child-height-predictor/" },
      ]}
    />

    <header class="mt-6 sm:mt-8 text-center">
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        Child Height Predictor
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mt-3 leading-relaxed max-w-2xl mx-auto">
        How tall will your child likely become? Enter both parents' adult heights and the
        child's sex for a mid-parental height estimate — always shown with its honest
        likely range, never as a single exact number.
      </p>
    </header>

    <div class="mt-6 max-w-3xl mx-auto">
      <MedicalDisclaimer />
      <div class="mt-4">
        <PredictorTool
          id="predictor-tool"
          heading="Predict adult height"
          intro="Parents' heights in cm or ft/in, plus the child's sex. The formula needs both parents — it won't guess from half the inputs."
        />
      </div>
    </div>

    <article class="max-w-3xl mx-auto mt-12 space-y-8 text-sm sm:text-base leading-relaxed text-slate-700 dark:text-slate-300">
      <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-soft">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mb-4">The formula</h2>
        <p>
          This is the classic <strong>Tanner mid-parental height</strong> formula, long used
          in pediatrics as a quick estimate of a child's genetic target height:
        </p>
        <ul class="space-y-2 list-disc pl-5 mt-4">
          <li><strong>Boy:</strong> (father's height + mother's height + 13 cm) ÷ 2</li>
          <li><strong>Girl:</strong> (father's height + mother's height − 13 cm) ÷ 2</li>
        </ul>
        <p class="mt-4">
          The ±13 cm adjustment reflects the average adult height difference between men
          and women. Enter heights in centimetres or feet and inches — the conversion uses
          the exact 1 inch = 2.54 cm definition.
        </p>
      </section>

      <section class="p-6 sm:p-8 rounded-3xl bg-amber-50/60 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-800/50 shadow-soft">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mb-4">How accurate is it, honestly?</h2>
        <p>
          The prediction estimates <strong>genetic target height — not a guaranteed outcome</strong>.
          Most children end up within <strong>±8.5 cm</strong> of the predicted value
          (roughly ±2 standard deviations of prediction error). <strong>No method predicts a
          child's adult height exactly</strong>, and any site that gives you a single precise
          number without a range is overselling.
        </p>
        <p class="mt-3">
          Beyond genes, final height is shaped by nutrition, childhood health, the timing
          of puberty, and ordinary genetic variation — factors no formula can fully capture.
          Treat the range as <em>likely</em>, not certain, and enjoy watching where they land.
        </p>
      </section>

      <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-soft">
        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white mb-4">What to explore next</h2>
        <p>
          Already know the child's current height? See where they stand today with the
          <a href="/height-calculator/boys-percentile/" class="font-bold text-brand-600 dark:text-blue-400 hover:underline"> boys percentile calculator</a> or
          <a href="/height-calculator/girls-percentile/" class="font-bold text-brand-600 dark:text-blue-400 hover:underline"> girls percentile calculator</a>,
          or plot them on the interactive
          <a href="/height-calculator/boys-chart/" class="font-bold text-brand-600 dark:text-blue-400 hover:underline"> boys growth chart</a> and
          <a href="/height-calculator/girls-chart/" class="font-bold text-brand-600 dark:text-blue-400 hover:underline"> girls growth chart</a>.
        </p>
      </section>
    </article>

    <CalcFaq items={faqs} title="Child height predictor FAQs" />

    <SiblingTools current="/height-calculator/child-height-predictor/" />

    <TrustStrip />
  </div>
</Layout>

<script>
  import { initAllPredictorTools } from "../../../lib/calc-tools.js";
  initAllPredictorTools();
</script>
